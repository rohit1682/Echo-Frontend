# Base URL of the Echo backend API.
# Leave this UNSET for local development — the app auto-selects the right host:
#   iOS simulator / web : http://localhost:4000/api
#   Android emulator    : http://10.0.2.2:4000/api
# Set it explicitly for a physical device (use your machine's LAN IP) or a deployed API:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:4000/api
# EXPO_PUBLIC_API_URL=
